# Dokploy Environment Variables Reference
# Copy these values into Dokploy's Environment Variables UI (not as a file)
#
# Note: Docker image is pulled from GHCR automatically:
#   ghcr.io/your-org/your-repo:latest (production)
#   ghcr.io/your-org/your-repo:dev (development)

# ===== Discord Bot Configuration =====
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
OWNER_IDS=123456789012345678

# Missile Strike swarm (optional)
# Comma-separated bot tokens used as ephemeral missile swarm instances.
# If empty, missile-strike is disabled in all guilds.
MISSILE_SWARM_TOKENS=
# Optional alternative format (also supported):
# MISSILE_SWARM_TOKEN_1=
# MISSILE_SWARM_TOKEN_2=

# ===== Bot Settings =====
DEFAULT_PREFIX=!
NODE_ENV=production
API_PORT=4000
API_PREFIX=api
API_ORIGIN=*
API_REDIRECT=https://api.yourdomain.com/api/oauth/callback

# ===== Dashboard =====
DASHBOARD_URL=https://yourdomain.com
NEXT_PUBLIC_BOT_API_URL=https://api.yourdomain.com

# ===== Database Configuration =====
# Points to postgres service running on host via docker-compose
DATABASE_URL="postgresql://postgres:your_password@postgres:5432/catto_prod?schema=public"

# ===== Redis Configuration =====
# Points to redis service running on host via docker-compose
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ===== Backblaze B2 Storage (optional) =====
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=your_key_id
B2_APP_KEY=your_app_key
B2_BUCKET_NAME=your_bucket_name
B2_BUCKET_ID=your_bucket_id

# ===== Security =====
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=your_32_char_hex_key
EVIDENCE_HMAC_SECRET=your_32_char_hex_secret

# ===== Watermark Service =====
# Points to watermark service running on host via docker-compose
WATERMARK_SERVICE_URL=http://watermark:3847
WATERMARK_MAX_UPLOAD_SIZE=1gb

# ===== Deploy Metadata =====
DEPLOY_VERSION=latest

# ===== Development Environment Overrides =====
# For dev deployment, change these values:
# - DISCORD_TOKEN → dev bot token
# - API_REDIRECT → https://api-dev.yourdomain.com/api/oauth/callback
# - DASHBOARD_URL → https://dev.yourdomain.com
# - NEXT_PUBLIC_BOT_API_URL → https://api-dev.yourdomain.com
# - DATABASE_URL → postgresql://postgres:password@postgres:5432/catto_dev?schema=public
# - REDIS_DB → 1 (different database for isolation)
# - DEPLOY_VERSION → dev
