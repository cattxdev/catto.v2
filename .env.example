# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Owner Configuration (comma-separated list of user IDs)
OWNER_IDS=123456789012345678

# Missile Strike swarm (optional)
# Comma-separated bot tokens used as ephemeral missile swarm instances.
# If empty, missile-strike is disabled in all guilds.
MISSILE_SWARM_TOKENS=
# Optional alternative format (also supported):
# MISSILE_SWARM_TOKEN_1=
# MISSILE_SWARM_TOKEN_2=

# Bot Settings
DEFAULT_PREFIX=!
NODE_ENV=development

# API Settings
API_PORT=4000
API_PREFIX=api

# Dashboard
NEXT_PUBLIC_BOT_API_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
# CORS origin — set to dashboard URL, or leave as * (auto-resolves to DASHBOARD_URL for cookie auth)
API_ORIGIN=*
API_REDIRECT=http://localhost:4000/api/oauth/callback

# Database Configuration
# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/catto_bot?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Backblaze B2 (optional, for evidence file storage)
# Endpoint format: https://s3.<region>.backblazeb2.com (https:// is added automatically if omitted)
B2_ENDPOINT=
B2_REGION=us-west-004
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=

# Session encryption key (required in production, generate with: openssl rand -hex 32)
SESSION_ENCRYPTION_KEY=
# Evidence signing (optional, generate with: openssl rand -hex 32)
EVIDENCE_HMAC_SECRET=

# Watermark microservice (optional, falls back to Sharp if unavailable)
# When using Docker Compose, this is automatically set to http://watermark:3847
WATERMARK_SERVICE_URL=http://localhost:3847
WATERMARK_MAX_UPLOAD_SIZE=1gb

# Image generation microservice (rank cards, leaderboards, bonk memes)
# When using Docker Compose, this is automatically set to http://image-gen:3848
IMAGE_GEN_SERVICE_URL=http://localhost:3848

# Deploy metadata (set automatically by deploy script)
DEPLOY_VERSION=dev

# Production: Caddy reverse proxy
CADDY_DOMAIN=api.localhost
CADDY_ACME_EMAIL=admin@example.com
