// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// Moderation action types
enum ModAction {
  BAN
  UNBAN
  KICK
  TIMEOUT
  WARN
  MUTE
  UNMUTE
  SOFTBAN
  TEMPBAN
}

// Moderation case status
enum CaseStatus {
  OPEN
  CLOSED
  VOID
}

// Appeal status
enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

// Example models for a Discord bot
// You can modify or remove these based on your needs

model Guild {
  id        String   @id @default(cuid())
  guildId   String   @unique
  name      String
  language  String   @default("en-US")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings  Json?

  users      User[]
  modCases   ModCase[]
  modConfig  ModConfig?
  logConfig  LogConfig?

  @@index([guildId])
  @@map("guilds")
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  guild   Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String?

  @@index([userId])
  @@index([guildId])
  @@map("users")
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@map("logs")
}

// Moderation Case Tracking
model ModCase {
  id          String     @id @default(cuid())
  caseNumber  Int        // Auto-incrementing per guild
  guildId     String
  action      ModAction
  targetId    String
  targetTag   String
  moderatorId String
  moderatorTag String
  reason      String?
  duration    Int?       // Duration in seconds for timeouts/tempbans
  status      CaseStatus @default(OPEN)
  evidence    Json?      // Message links, attachments, etc.
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  expiresAt   DateTime?
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetId])
  @@index([moderatorId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@map("mod_cases")
}

// Moderation Configuration per Guild
model ModConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  modLogChannelId String?  // Channel for moderation logs
  muteRoleId      String?  // Role for muting users
  autoModEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("mod_configs")
}

// Logging Configuration per Guild
model LogConfig {
  id                    String   @id @default(cuid())
  guildId               String   @unique
  categoryId            String?  // Category for log channels
  enabled               Boolean  @default(false)
  
  // Webhook URLs for each log type
  messagesWebhook       String?
  voiceWebhook          String?
  voiceStateWebhook     String?
  ticketsWebhook        String?
  transcriptsWebhook    String?
  rolesWebhook          String?
  channelsWebhook       String?
  membersWebhook        String?
  stageWebhook          String?
  eventsWebhook         String?
  pollsWebhook          String?
  emojisWebhook         String?
  stickersWebhook       String?
  webhooksWebhook       String?
  joinsWebhook          String?
  leavesWebhook         String?
  serverWebhook         String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("log_configs")
}

// User Moderation Notes
model UserModNote {
  id          String   @id @default(cuid())
  guildId     String
  userId      String   // Target user ID
  createdById String   // Moderator who created the note
  note        String   @db.Text
  tags        String[] // Tags for categorization
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([userId])
  @@index([guildId, userId])
  @@index([createdById])
  @@map("user_mod_notes")
}

// Moderation Appeals
model ModAppeal {
  id          String       @id @default(cuid())
  guildId     String
  targetId    String       // User who submitted the appeal
  caseId      String?      // Optional reference to the case being appealed
  createdById String       // Can be different from targetId if mod creates on behalf
  reason      String       @db.Text
  status      AppealStatus @default(PENDING)
  resolution  String?      @db.Text
  resolvedById String?     // Moderator who resolved the appeal
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?

  @@index([guildId])
  @@index([targetId])
  @@index([status])
  @@index([guildId, status])
  @@map("mod_appeals")
}

// Scheduled Tasks for Tempbans
model ScheduledTask {
  id          String   @id @default(cuid())
  type        String   // e.g., "TEMPBAN_UNBAN"
  guildId     String
  targetId    String
  data        Json?    // Additional task data
  executeAt   DateTime
  createdAt   DateTime @default(now())
  processed   Boolean  @default(false)

  @@index([type])
  @@index([executeAt])
  @@index([processed, executeAt])
  @@map("scheduled_tasks")
}
