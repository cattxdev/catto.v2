// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
}

// Example models for a Discord bot
// You can modify or remove these based on your needs

model Guild {
  id        String   @id @default(cuid())
  guildId   String   @unique
  name      String
  language  String   @default("en-US")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings  Json?

  users      User[]
  modCases   ModCase[]
  modConfig  ModConfig?

  @@index([guildId])
  @@map("guilds")
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  guild   Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String?

  @@index([userId])
  @@index([guildId])
  @@map("users")
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@map("logs")
}

// Moderation Case Tracking
model ModCase {
  id          String   @id @default(cuid())
  caseNumber  Int      // Auto-incrementing per guild
  guildId     String
  action      String   // BAN, KICK, WARN, TIMEOUT, MUTE, UNMUTE, UNBAN
  targetId    String
  targetTag   String
  moderatorId String
  moderatorTag String
  reason      String?
  duration    Int?     // Duration in seconds for timeouts/tempbans
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetId])
  @@index([moderatorId])
  @@index([action])
  @@index([createdAt])
  @@map("mod_cases")
}

// Moderation Configuration per Guild
model ModConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  modLogChannelId String?  // Channel for moderation logs
  muteRoleId      String?  // Role for muting users
  autoModEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("mod_configs")
}
