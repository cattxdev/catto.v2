// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// Example models for a Discord bot
// You can modify or remove these based on your needs

model Guild {
  id        String   @id @default(cuid())
  guildId   String   @unique
  name      String
  language  String   @default("en-US")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings  Json?

  users         User[]
  modCases      ModCase[]
  modConfig     ModConfig?
  logConfig     LogConfig?
  xpConfig      GuildXPConfig?
  userXP        UserXP[]
  xpEventLogs   XPEventLog[]

  @@index([guildId])
  @@map("guilds")
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  guild   Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String?

  @@index([userId])
  @@index([guildId])
  @@map("users")
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@map("logs")
}

// Moderation Case Tracking
model ModCase {
  id          String   @id @default(cuid())
  caseNumber  Int      // Auto-incrementing per guild
  guildId     String
  action      String   // BAN, KICK, WARN, TIMEOUT, MUTE, UNMUTE, UNBAN
  targetId    String
  targetTag   String
  moderatorId String
  moderatorTag String
  reason      String?
  duration    Int?     // Duration in seconds for timeouts/tempbans
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetId])
  @@index([moderatorId])
  @@index([action])
  @@index([createdAt])
  @@map("mod_cases")
}

// Moderation Configuration per Guild
model ModConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  modLogChannelId String?  // Channel for moderation logs
  muteRoleId      String?  // Role for muting users
  autoModEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("mod_configs")
}

// Logging Configuration per Guild
model LogConfig {
  id                    String   @id @default(cuid())
  guildId               String   @unique
  categoryId            String?  // Category for log channels
  enabled               Boolean  @default(false)
  
  // Webhook URLs for each log type
  messagesWebhook       String?
  voiceWebhook          String?
  voiceStateWebhook     String?
  ticketsWebhook        String?
  transcriptsWebhook    String?
  rolesWebhook          String?
  channelsWebhook       String?
  membersWebhook        String?
  stageWebhook          String?
  eventsWebhook         String?
  pollsWebhook          String?
  emojisWebhook         String?
  stickersWebhook       String?
  webhooksWebhook       String?
  joinsWebhook          String?
  leavesWebhook         String?
  serverWebhook         String?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("log_configs")
}
// XP/Leveling Configuration per Guild
model GuildXPConfig {
  id                    String   @id @default(cuid())
  guildId               String   @unique
  enabled               Boolean  @default(true)
  
  // XP Award Settings
  cooldownSec           Int      @default(60)    // Cooldown between XP awards
  xpMode                String   @default("RANDOM") // "RANDOM" | "FIXED"
  minXp                 Int      @default(15)    // For RANDOM mode
  maxXp                 Int      @default(25)    // For RANDOM mode
  fixedXp               Int      @default(20)    // For FIXED mode
  minMessageLength      Int      @default(5)     // Minimum message length to award XP
  maxXpPerMinute        Int?                     // Optional rate limit
  
  // Channel & Role Filters (JSONB arrays)
  allowedChannels       String[] @default([])   // If empty, all channels allowed
  ignoredChannels       String[] @default([])   // Always ignored
  ignoredRoles          String[] @default([])   // Users with these roles ignored
  
  // Level-Up Announcements
  announceLevelUp       Boolean  @default(true)
  announceChannelId     String?                 // If null, announce in message channel
  messageTemplate       String   @default("🎉 {user} reached level {level}!")
  embedEnabled          Boolean  @default(true)
  embedColor            Int      @default(5793266) // Hex 0x5865F2 (Discord Blurple)
  
  // Level Curve Configuration
  levelCurveType        String   @default("FORMULA") // "FORMULA" | "TABLE"
  // Formula: xpRequired = base * (level ^ exponent) + offset
  formulaBase           Float    @default(5.0)
  formulaExponent       Float    @default(2.0)
  formulaOffset         Float    @default(50.0)
  // Table: Array of cumulative XP thresholds [100, 255, 475, 770, ...] for levels 1, 2, 3, 4...
  tableThresholds       Int[]    @default([])
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("guild_xp_configs")
}

// User XP per Guild
model UserXP {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  xp            Int       @default(0)
  level         Int       @default(0)
  messageCount  Int       @default(0)
  lastAwardAt   DateTime?                    // For cooldown enforcement
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, xp(sort: Desc)])          // For leaderboard queries
  @@index([guildId, userId])
  @@index([lastAwardAt])                       // For cooldown checks
  @@map("user_xp")
}

// Audit Log for XP Events (optional but recommended)
model XPEventLog {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  eventType   String                          // "AWARD" | "LEVEL_UP" | "RESET" | "MANUAL_ADJUST"
  xpChange    Int                             // Amount of XP change (can be negative)
  xpBefore    Int
  xpAfter     Int
  levelBefore Int
  levelAfter  Int
  reason      String?                         // Optional context (e.g., "message", "admin reset")
  metadata    Json?                           // Additional context (channelId, messageId, etc.)
  createdAt   DateTime @default(now())
  
  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@index([eventType])
  @@map("xp_event_logs")
}