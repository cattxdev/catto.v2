{
  "name": "catto.v2x",
  "version": "1.0.0",
  "description": "A TypeScript Discord bot built with Sapphire Framework",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "prisma migrate reset"
  },
  "keywords": [
    "discord",
    "bot",
    "sapphire",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "imports": {
    "#root/*": "./dist/*",
    "#structures/*": "./dist/structures/*",
    "#commands/*": "./dist/commands/*",
    "#listeners/*": "./dist/listeners/*",
    "#routes/*": "./dist/routes/*",
    "#preconditions/*": "./dist/preconditions/*",
    "#lib/*": "./dist/lib/*",
    "#config": "./dist/config.js"
  },
  "dependencies": {
    "@prisma/client": "^7.2.0",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/plugin-api": "^8.3.1",
    "@sapphire/plugin-logger": "^4.0.3",
    "@sapphire/utilities": "^3.17.3",
    "discord-api-types": "^0.38.37",
    "discord.js": "~14.25.1",
    "dotenv": "^16.4.7",
    "prisma": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.22.1",
    "@typescript-eslint/parser": "^8.22.1",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
